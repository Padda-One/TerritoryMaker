---
import "../styles/global.css";
import Analytics from "../components/Analytics.astro";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="canonical"
      href="https://territory.paddaone.com/mentions-legales/"
    />
    <meta
      name="description"
      content="Mentions légales de Territory Maker : éditeur, hébergeur, données personnelles, clé API, cookies, données cartographiques et code source."
    />
    <meta name="author" content="Paddaone" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta
      property="og:url"
      content="https://territory.paddaone.com/mentions-legales/"
    />
    <meta property="og:site_name" content="Territory Maker" />
    <meta property="og:title" content="Mentions légales — Territory Maker" />
    <meta
      property="og:description"
      content="Mentions légales de Territory Maker : éditeur, hébergeur, données personnelles, clé API, cookies, données cartographiques."
    />
    <meta
      property="og:image"
      content="https://territory.paddaone.com/og-preview.png"
    />
    <meta property="og:locale" content="fr_FR" />

    <!-- Twitter/X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Mentions légales — Territory Maker" />
    <meta
      name="twitter:description"
      content="Mentions légales de Territory Maker : éditeur, hébergeur, données personnelles."
    />
    <meta
      name="twitter:image"
      content="https://territory.paddaone.com/og-preview.png"
    />

    <title>Mentions légales — Territory Maker</title>
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/favicon-48x48.png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/svg+xml" href="/logo-TerritoryMaker.svg" />

    <Analytics />
  </head>

  <body>
    <!-- Header -->
    <header class="doc-header">
      <div class="doc-header-inner">
        <a href="/" class="doc-back-link">
          <span>←</span>Retour à l'app
        </a>
        <span class="doc-header-divider">|</span>
        <div class="doc-header-logo">
          <img src="/logo-TerritoryMaker.svg" width="50" height="50" alt="" />
          <span>Territory Maker</span>
        </div>
      </div>
    </header>

    <!-- Layout -->
    <div class="doc-layout">
      <main class="doc-content">
        <!-- Title -->
        <div style="margin-bottom:40px;">
          <div
            style="display:inline-flex;align-items:center;gap:8px;background:rgba(0,229,160,0.1);border:1px solid rgba(0,229,160,0.25);border-radius:9999px;padding:4px 14px;font-size:0.75rem;font-weight:600;color:#00e5a0;margin-bottom:16px;"
          >
            Mentions légales
          </div>
          <h1
            style="font-size:1.75rem;font-weight:800;color:#e2e8f0;margin:0 0 12px;line-height:1.2;"
          >
            Protocole légal
          </h1>
          <p
            style="font-size:0.95rem;color:#94a3b8;margin:0;line-height:1.6;"
          >
            Informations légales relatives au site
            <strong>territory.paddaone.com</strong>, édité par Padda-One.
          </p>
        </div>

        <!-- ─── Section 1 : Entité Éditrice ─── -->
        <section id="editeur" style="margin-bottom:40px;">
          <div class="chapter-header">
            <div class="chapter-number">1</div>
            <h2 class="chapter-title">Entité éditrice</h2>
          </div>
          <div class="doc-section">
            <div class="legal-section">
              <h3 class="legal-section-title">Dénomination et forme juridique</h3>
              <p>
                Le site <strong>territory.paddaone.com</strong> est édité par
                <strong style="color:var(--color-accent-blue)">EI Olivier
                DUPONT</strong> — entreprise individuelle
                (micro-entreprise).
              </p>
            </div>
            <div class="legal-section">
              <h3 class="legal-section-title">RCS</h3>
              <p>524448537</p>
            </div>
            <div class="legal-section">
              <h3 class="legal-section-title">Adresse du siège</h3>
              <p>
                13 Av. Jean Sillard, 53100 Châtil<!--x-->lon-sur-Colmont,
                France
              </p>
            </div>
            <div class="legal-section">
              <h3 class="legal-section-title">E-mail</h3>
              <p>olivier@padda<!--x-->one.com</p>
            </div>
            <div class="legal-section">
              <h3 class="legal-section-title">Téléphone</h3>
              <p>07 45 0<!--x-->7 50 11</p>
            </div>
            <div class="legal-section">
              <h3 class="legal-section-title">Directeur de publication</h3>
              <p>
                DUPONT Olivier, responsable légal de l'entreprise.
              </p>
            </div>
          </div>
        </section>

        <!-- ─── Section 2 : Infrastructures / Hébergeur ─── -->
        <section id="hebergeur" style="margin-bottom:40px;">
          <div class="chapter-header">
            <div class="chapter-number">2</div>
            <h2 class="chapter-title">Infrastructures et hébergeur</h2>
          </div>
          <div class="doc-section">
            <div class="legal-section">
              <h3 class="legal-section-title">Hébergeur</h3>
              <p>
                Le site est hébergé par <strong
                  style="color:var(--color-accent-blue)">Cloudflare
                  Pages</strong
                > — Cloudflare, Inc., 101 Townsend St, San Francisco, CA 94107,
                États-Unis. Aucun serveur applicatif persistant.
              </p>
            </div>
          </div>
        </section>

        <!-- ─── Section 3 : Données Personnelles ─── -->
        <section id="donnees-personnelles" style="margin-bottom:40px;">
          <div class="chapter-header">
            <div class="chapter-number">3</div>
            <h2 class="chapter-title">Données personnelles</h2>
          </div>
          <div class="doc-section">
            <div class="legal-section">
              <p>
                Aucune donnée personnelle n'est collectée, traitée ou
                transmise. Les configurations sont encapsulées dans le
                périmètre local du navigateur.
              </p>
            </div>
          </div>
        </section>

        <!-- ─── Section 4 : Clé API ─── -->
        <section id="cle-api" style="margin-bottom:40px;">
          <div class="chapter-header">
            <div class="chapter-number">4</div>
            <h2 class="chapter-title">Clé API</h2>
          </div>
          <div class="doc-section">
            <div class="legal-section">
              <p>
                En mode clé partagée, la clé est gérée côté serveur. En mode
                clé personnelle, votre clé Google Maps API est stockée
                uniquement dans votre navigateur, chiffrée AES-GCM 256 bits.
                Elle n'est jamais transmise à l'éditeur ni à un tiers.
              </p>
            </div>
          </div>
        </section>

        <!-- ─── Section 5 : Cookies ─── -->
        <section id="cookies" style="margin-bottom:40px;">
          <div class="chapter-header">
            <div class="chapter-number">5</div>
            <h2 class="chapter-title">Cookies</h2>
          </div>
          <div class="doc-section">
            <div class="legal-section">
              <p>Aucun cookie d'aucune sorte.</p>
            </div>
          </div>
        </section>

        <!-- ─── Section 6 : Données Cartographiques ─── -->
        <section id="donnees-cartographiques" style="margin-bottom:40px;">
          <div class="chapter-header">
            <div class="chapter-number">6</div>
            <h2 class="chapter-title">Données cartographiques</h2>
          </div>
          <div class="doc-section">
            <div class="legal-section">
              <p>
                Tuiles fournies par Google Maps API et/ou OpenStreetMap. ©
                Contributeurs OpenStreetMap, licence <a
                  href="https://opendatacommons.org/licenses/odbl/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="lp-inline-link">ODbL</a
                >.
              </p>
            </div>
          </div>
        </section>

        <!-- ─── Section 7 : Code Source ─── -->
        <section id="code-source" style="margin-bottom:40px;">
          <div class="chapter-header">
            <div class="chapter-number">7</div>
            <h2 class="chapter-title">Code source</h2>
          </div>
          <div class="doc-section">
            <div class="legal-section">
              <p>
                Public et auditable sur <a
                  href="https://github.com/Padda-One/TerritoryMaker"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="lp-inline-link"
                  >GitHub — https://github.com/Padda-One/TerritoryMaker</a
                >.
              </p>
            </div>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>
